# ──────────────────────────────────────────────
# RFPinator – Environment Variables
# Copy to .env and fill in values before running
# ──────────────────────────────────────────────

# ── LLM Providers ────────────────────────────
# OpenAI – used for embeddings and evaluation judge (GPT-4.1)
OPENAI_API_KEY=sk-...

# Groq – default answering model for RAG queries
GROQ_API_KEY=gsk_...

# ── Vector Store ─────────────────────────────
# ChromaDB – local: localhost / Railway: use internal hostname
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=rfpinator_policies

# ── Backend (NestJS) ─────────────────────────
# Railway sets PORT automatically; API_PORT is the fallback
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ── Frontend (Next.js) ───────────────────────
# Local: http://localhost:3001 / Railway: use your API service's public URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Evaluation Pipeline ─────────────────────
# Model used as the LLM judge for faithfulness scoring
EVAL_JUDGE_MODEL=gpt-4.1
# Path to golden dataset file (relative to repo root)
EVAL_GOLDEN_DATASET_PATH=golden_dataset.json

# ── LlamaIndex.TS ───────────────────────────
# LlamaIndex uses OPENAI_API_KEY by default for embeddings.
# Override embedding model if needed:
# LLAMAINDEX_EMBEDDING_MODEL=text-embedding-3-small
# LLAMAINDEX_CHUNK_SIZE=512
# LLAMAINDEX_CHUNK_OVERLAP=50

